@@ -0,0 +1,41 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <vector>
+
+namespace osr {
+
+// A bounded negative proof, not an approximate router. Return false whenever a
+// target or the work limit is reached. Nodes must preserve ALL routing state.
+// Seed/expand enumerate a superset of possible transitions (no cost pruning).
+template <typename Node, typename Seed, typename Expand, typename IsTarget>
+bool exhausted_component_misses(Seed&& seed,
+                                 Expand&& expand,
+                                 IsTarget&& is_target,
+                                 std::size_t const limit = 256U) {
+  auto nodes = std::vector<Node>{};
+  nodes.reserve(limit);
+  auto inconclusive = false;
+  auto const add = [&](Node const node) {
+    if (inconclusive) {
+      return;
+    }
+    if (is_target(node) || nodes.size() == limit) {
+      inconclusive = true;
+      return;
+    }
+    if (std::find(begin(nodes), end(nodes), node) == end(nodes)) {
+      nodes.push_back(node);
+    }
+  };
+  seed(add);
+  for (auto i = std::size_t{0U}; i < nodes.size() && !inconclusive; ++i) {
+    // Copy the state: expansion can grow and reallocate the queue.
+    auto const current = nodes[i];
+    expand(current, add);
+  }
+  return !inconclusive;
+}
+
+}  // namespace osr
