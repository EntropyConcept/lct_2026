+// Prove misses on tiny directed islands before searching the whole city from
+// the opposite endpoint. A work-limit hit or ANY destination node is inconclusive.
+template <Profile P, direction Dir>
+bool small_component_misses(typename P::parameters const& params,
+                            ways const& w,
+                            location const& from,
+                            way_idx_t const start_way,
+                            candidate_node const& left,
+                            candidate_node const& right,
+                            std::vector<node_idx_t> const& targets) {
+  return exhausted_component_misses<typename P::node>(
+      [&](auto const& add) {
+        for (auto const* nc : {&left, &right}) {
+          if (nc->valid()) {
+            P::resolve_start_node(*w.r_, start_way, nc->node_, from.lvl_, Dir,
+                                  add);
+          }
+        }
+      },
+      [&](typename P::node const current, auto const& add) {
+        // Ignoring costs, blocked nodes and the time limit only overestimates
+        // reachability. Only static road profiles without sharing use it.
+        P::template adjacent<Dir, false>(
+            params, *w.r_, w.timezones_, current, duration_t{0}, std::nullopt,
+            nullptr, nullptr, nullptr,
+            [&](typename P::node const next, std::uint32_t const cost,
+                auto&&...) {
+              if (cost != kInfeasible) {
+                add(next);
+              }
+            });
+      },
+      [&](typename P::node const node) {
+        return std::binary_search(begin(targets), end(targets), node.get_node());
+      });
 }
 
