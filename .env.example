# Copy to .env. Defaults serve the demo at http://localhost:8080.
IMAGE_PREFIX=ghcr.io/entropyconcept/lct_2026
IMAGE_TAG=main
DISPATCH_LISTEN_ADDRESS=127.0.0.1
DISPATCH_PORT=8080
# Must match the browser URL, including scheme and any non-default port.
DISPATCH_PUBLIC_ORIGIN=http://localhost:8080
DISPATCH_ROAD_BACKEND=motis
DISPATCH_MOTIS_URL=http://motis:8081
DISPATCH_TRANSIT_WORKERS=4
DISPATCH_ROAD_WORKERS=8
MOTIS_INPUT_DIR=./.transit/docker-inputs
MOTIS_BUILD_JOBS=2
